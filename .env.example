# ============================================================
# PatentRadar v1 配置模板
# 复制为 .env 并填写实际 key（.env 不会被提交）
# 所有 LLM 接口走 OpenAI 兼容协议（chat.completions），除主控走 OAuth 外
# ============================================================

# ---------- 主控 / 最终复核 LLM (GPT-5.5) ----------
# GPT-5.5 走 ChatGPT Plus/Pro OAuth (~/.codex/auth.json)，
# api_key / base_url 仅占位，实际不读；先用官方 codex CLI `codex login` 登录账号。
REVIEWER_API_KEY=chatgpt-oauth
REVIEWER_BASE_URL=chatgpt://codex
REVIEWER_MODEL=gpt-5.5
REVIEWER_REASONING_EFFORT=medium       # low | medium | high
DECOMPOSER_REASONING_EFFORT=medium
REVIEWER_CONTEXT_WINDOW=400000

# ---------- 三个搜索 Agent ----------
# Agent 1: GLM - 语义扩展视角
SEARCH_AGENT_1_API_KEY=
SEARCH_AGENT_1_BASE_URL=
SEARCH_AGENT_1_MODEL=
SEARCH_AGENT_1_CONTEXT_WINDOW=128000

# Agent 2: Kimi - 官方/长文资料视角
SEARCH_AGENT_2_API_KEY=
SEARCH_AGENT_2_BASE_URL=
SEARCH_AGENT_2_MODEL=
SEARCH_AGENT_2_CONTEXT_WINDOW=200000

# Agent 3: DeepSeek - 中文公开资料视角
SEARCH_AGENT_3_API_KEY=
SEARCH_AGENT_3_BASE_URL=
SEARCH_AGENT_3_MODEL=
SEARCH_AGENT_3_CONTEXT_WINDOW=128000

# ---------- 4 个搜索 API ----------
BOCHA_API_KEY=
EXA_API_KEY=
BRAVE_API_KEY=
TAVILY_API_KEY=

# ---------- 运行参数 ----------
DECOMPOSER_LLM=reviewer                # reviewer | agent1 | agent2 | agent3
PATENT_FETCH_TIMEOUT=30
LLM_TIMEOUT=120
AGENT_LLM_TIMEOUT=240
# 动态上下文压缩：预算 = ctx_window * 比例 - 输出预留
COMPACTOR_BUDGET_RATIO=0.7
COMPACTOR_OUTPUT_RESERVE=4096
# 摘要压缩用的 LLM 端点（便宜模型即可）
COMPACTOR_LLM=agent3
