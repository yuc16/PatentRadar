# ====== LLM backend ======
# `codex`  = ChatGPT OAuth + Codex Responses SSE，需要先跑 `codex login`
# `openai` = 任意 OpenAI 兼容 /chat/completions（aihubmix / DeepSeek / 自建网关 ...）
PATENTRADAR_LLM_BACKEND=codex
# PATENTRADAR_LLM_BACKEND=openai


# 当 PATENTRADAR_LLM_BACKEND=codex时，使用codex，使用以下参数，默认支持多模态
PATENTRADAR_MODEL=gpt-5.5
# 模型上下文窗口大小（单位 tokens；默认 258K 对应 gpt-5.5 codex）。换模型时只改这一项，
# 项目内 prompt-size 监控 / payload 压缩目标会自动按比例派生（critical / warn / compress target）。
# 此参数同时适用于 codex 后端 和 openai 兼容后端——两边走同一组阈值。
PATENTRADAR_CONTEXT_LENGTH=258000
PATENTRADAR_REASONING_EFFORT=high

# 当 PATENTRADAR_LLM_BACKEND=openai时，使用OpenAI 兼容侧，使用以下参数（默认忽略"推理强度"参数）
# PATENTRADAR_CONTEXT_LENGTH 在 openai 后端同样生效——按所选模型的实际 context window 设置
# PATENTRADAR_MODEL=
# PATENTRADAR_OPENAI_BASE_URL=
# PATENTRADAR_OPENAI_API_KEY=sk-xxxxxx
# PATENTRADAR_CONTEXT_LENGTH=
# 当所选模型支持图像输入（vision）时设为 true，否则 decompose 含公式/图示的专利会跳过 PDF Vision：
# PATENTRADAR_OPENAI_VISION=false


# ====== 搜索 provider keys（模块二/三用）======
# 至少连接一个，连接的越多，效果越好。Tavily 支持多 key 轮换：用 TAVILY_API_KEYS（单行、逗号分隔）。
# 若只有一个 key，仍可用 TAVILY_API_KEY=xxx 单 key 写法（向后兼容）。
TAVILY_API_KEYS=tvly-xxx1,tvly-xxx2,tvly-xxx3
BOCHA_API_KEY=
EXA_API_KEY=
BRAVE_API_KEY=
