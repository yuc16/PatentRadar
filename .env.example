# ====== LLM backend ======
# `codex`  = ChatGPT OAuth + Codex Responses SSE，需要先跑 `codex login`
# `openai` = 任意 OpenAI 兼容 /chat/completions（aihubmix / DeepSeek / 自建网关 ...）
PATENTRADAR_LLM_BACKEND=codex
# PATENTRADAR_LLM_BACKEND=openai


# 当 PATENTRADAR_LLM_BACKEND=codex时，使用codex，使用以下参数，默认支持多模态
PATENTRADAR_MODEL=gpt-5.5
PATENTRADAR_CONTEXT_LENGTH=258000
PATENTRADAR_REASONING_EFFORT=high

# # 当 PATENTRADAR_LLM_BACKEND=openai时，使用OpenAI 兼容侧，使用以下参数
# PATENTRADAR_OPENAI_BASE_URL=
# PATENTRADAR_OPENAI_API_KEY=sk-xxxxxx
# 仅当所选模型支持图像输入（vision）时设为 true，否则 decompose 含公式/图示的专利会跳过 PDF Vision：
# PATENTRADAR_OPENAI_VISION=false


# ====== 搜索 provider keys（模块二/三用）======
TAVILY_API_KEY=
BOCHA_API_KEY=
EXA_API_KEY=
BRAVE_API_KEY=
