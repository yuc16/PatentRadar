# ====== LLM backend ======
# `codex`  = ChatGPT OAuth + Codex Responses SSE，需要先跑 `codex login`
# `openai` = 任意 OpenAI 兼容 /chat/completions（aihubmix / DeepSeek / 自建网关 ...）
PATENTRADAR_LLM_BACKEND=codex

# 当 PATENTRADAR_LLM_BACKEND=openai 时必填：
# PATENTRADAR_OPENAI_BASE_URL=https://aihubmix.com/v1
# PATENTRADAR_OPENAI_API_KEY=sk-xxxxxx
# 同时建议把 PATENTRADAR_MODEL 指向兼容侧的模型名（如 deepseek-v4-pro / gpt-4o-mini / qwen-max...）
# 仅当所选模型支持图像输入（vision）时把这个设为 true，否则 decompose 含公式/图示的专利会跳过 PDF Vision：
# PATENTRADAR_OPENAI_VISION=false

# ====== 通用 LLM 调参 ======
# Codex 侧使用，OpenAI 兼容侧目前会忽略 reasoning_effort / verbosity 这俩字段
PATENTRADAR_MODEL=gpt-5.5
PATENTRADAR_CONTEXT_LENGTH=258000
PATENTRADAR_REASONING_EFFORT=high

# ====== 搜索 provider keys（模块二/三用）======
TAVILY_API_KEY=
BOCHA_API_KEY=
EXA_API_KEY=
BRAVE_API_KEY=
